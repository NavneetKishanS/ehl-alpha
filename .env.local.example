# Copy to .env.local (already gitignored) and fill in.
# Used by src/lib/ai.ts once Role B wires in real OpenAI calls,
# and by the Python parsing pipeline (parsing/) for figure captions.

OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=
# Pingu chat assistant model (defaults to gpt-4.1-mini if unset)
OPENAI_CHAT_MODEL=

# Optional caption / parse tuning (defaults shown in .env.example)
# CAPTION_TIMEOUT_S=60
# CAPTION_CONCURRENCY=2
# PARSE_BATCH_SIZE=5
