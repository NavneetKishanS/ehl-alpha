# Copy to .env.local and fill in values. `.env.local` is loaded first, then `.env`.

# OpenAI (or OpenAI-compatible) credentials for figure captioning
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Vision model used for figure captions — required when captions are enabled.
# Examples: gpt-4.1-mini, gpt-4o-mini, gpt-4o
OPENAI_VISION_MODEL=

# Caption client tuning
CAPTION_TIMEOUT_S=60
CAPTION_CONCURRENCY=2
CAPTION_MAX_RETRIES=4
CAPTION_BACKOFF_S=1.5

# Parsing pipeline
PARSE_BATCH_SIZE=5
IMAGES_SCALE=2.0
PAGE_IMAGE_SCALE=2.0
